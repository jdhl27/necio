---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import FilmStrip from "../components/FilmStrip.astro";
import Services from "../components/Services.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import Allies from "../components/Allies.astro";
import Manifesto from "../components/Manifesto.astro";
import Gallery from "../components/Gallery.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { fetchVideos } from "../lib/youtube";

const title = "Necio — Productora audiovisual en Medellín";
const seoDescription =
  "Productora audiovisual en Medellín. Hacemos video, edición, fotografía y color para marcas, organizaciones e historias de barrio.";

const limitVideos = 6;
const videos = await fetchVideos();
---

<Layout title={title} description={seoDescription}>
  <main>
    <Hero />
    <FilmStrip videos={videos} />
    <Services />

    <section
      id="trabajo"
      class="mx-auto max-w-wrap scroll-mt-24 border-t border-line px-4 py-20 sm:px-6 lg:py-28"
    >
      <SectionHeader
        num="02 — Trabajo reciente"
        title="Últimos videos"
        sub="Lo último que hemos publicado en el canal."
      >
        <a
          href="/videos"
          class="display border border-cream/40 px-6 py-3 text-lg transition-colors hover:border-yellow hover:text-yellow"
          data-test="see-all-link"
        >
          Ver todos &rarr;
        </a>
      </SectionHeader>

      <div
        class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
        data-test="articles-section"
        data-reveal-stagger
      >
        {
          videos.slice(0, limitVideos).map((video, i) => (
            <div class:list={[i === 0 && "md:col-span-2"]}>
              <Card video={video} featured={i === 0} fill={i === 1} />
            </div>
          ))
        }
      </div>
    </section>

    <Allies />
    <Manifesto />
    <Gallery limit={9} allLink />
    <EmailSignup />
  </main>
</Layout>
