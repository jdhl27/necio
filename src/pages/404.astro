---
import Layout from "../layouts/Layout.astro";

const title = "404 | Necio";
const description = "Esta página no existe.";
---

<Layout title={title} description={description}>
  <main class="mx-auto max-w-wrap px-4 py-20 text-center sm:px-6 lg:py-32">
    <p class="slate justify-center">Corte — no quedó</p>
    <h1 class="display mt-6 text-fluid-hero">
      4<span class="text-yellow">0</span>4
    </h1>
    <p class="display mt-4 text-fluid-sub">
      Esta página <span class="outline-text">no existe</span>
    </p>
    <p class="mx-auto mt-6 max-w-md text-muted">
      No hay nada en esta dirección. Mientras decides a dónde ir, te dejamos
      uno de nuestros videos.
    </p>

    <div class="mx-auto mt-12 aspect-video max-w-2xl border border-line">
      <iframe
        class="h-full w-full"
        src="https://www.youtube.com/embed/EfPCRcUFjuQ?si=Fp6eSFTfu4Nk2pRx"
        title="Video de Necio"
        allow="accelerometer; autoplay; encrypted-media; gyroscope;"
        allowfullscreen></iframe>
    </div>

    <a
      href="/"
      class="display mt-12 inline-block bg-yellow px-8 py-4 text-lg text-ink transition-transform duration-200 hover:-translate-y-1 hover:rotate-1"
    >
      Volver al inicio &larr;
    </a>
  </main>
</Layout>
