---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SearchInput from "../components/SearchInput.astro";

const title = "Buscar | Necio";
const seoDescription = "Busca entre todos los videos de Necio.";
---

<Layout title={title} description={seoDescription}>
  <main class="mx-auto max-w-wrap px-4 py-16 sm:px-6 lg:py-24">
    <SectionHeader
      num="Buscador"
      title="¿Qué buscas?"
      sub="Escribe al menos dos letras y te mostramos los videos que coinciden."
    />
    <SearchInput />
  </main>
</Layout>
