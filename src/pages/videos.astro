---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Card from "../components/Card.astro";
import EmailSignup from "../components/EmailSignup.astro";
import { fetchVideos } from "../lib/youtube";

const title = "Videos | Necio";
const seoDescription =
  "Todos los videos de Necio: reels, documental, publicidad y contenido audiovisual.";

const videos = await fetchVideos();
---

<Layout title={title} description={seoDescription}>
  <main class="mx-auto max-w-wrap px-4 py-16 sm:px-6 lg:py-24">
    <SectionHeader
      num={`Archivo — ${videos.length} videos`}
      title="Todos los videos"
      sub="Todo lo que hemos publicado, del más nuevo al más viejo."
    >
      <a
        href="/buscar"
        class="display border border-cream/40 px-6 py-3 text-lg transition-colors hover:border-yellow hover:text-yellow"
      >
        Buscar &rarr;
      </a>
    </SectionHeader>

    <div
      class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3"
      data-test="articles-section"
    >
      {videos.map((video) => <Card video={video} />)}
    </div>
  </main>

  <EmailSignup />
</Layout>
