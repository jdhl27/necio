---
import BaseHead from "../components/Head/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer/Footer.astro";

export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<html lang="es">
  <head>
    <BaseHead title={title} description={description} />
  </head>

  <body class="bg-ink text-cream font-body antialiased">
    <Nav />
    <slot />
    <Footer />

    <script>
      // Sistema de reveal al scroll. Si el usuario prefiere menos movimiento
      // (o JS no corre), el contenido se muestra sin animaciones.
      const reduced = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;

      if (!reduced) {
        document.documentElement.classList.add("reveal-init");

        // Grupos: los hijos entran en cascada; el valor del atributo
        // define la variante (p. ej. data-reveal-stagger="left")
        document
          .querySelectorAll<HTMLElement>("[data-reveal-stagger]")
          .forEach((group) => {
            const variant = group.getAttribute("data-reveal-stagger") ?? "";
            let i = 0;
            [...group.children].forEach((child) => {
              if (child instanceof HTMLInputElement && child.type === "hidden")
                return;
              if (!child.hasAttribute("data-reveal")) {
                child.setAttribute("data-reveal", variant);
              }
              (child as HTMLElement).style.setProperty(
                "--reveal-delay",
                `${Math.min(i * 0.05, 0.25)}s`
              );
              i++;
            });
          });

        // Los elementos "wipe" están 100% recortados por clip-path, así que
        // el observer nunca los vería: se observa a su padre en su lugar.
        const byTarget = new Map<Element, Element[]>();
        document.querySelectorAll("[data-reveal]").forEach((el) => {
          const target =
            el.getAttribute("data-reveal") === "wipe"
              ? (el.parentElement ?? el)
              : el;
          const list = byTarget.get(target) ?? [];
          list.push(el);
          byTarget.set(target, list);
        });

        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                byTarget
                  .get(entry.target)
                  ?.forEach((el) => el.classList.add("revealed"));
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.05, rootMargin: "0px 0px 0px 0px" }
        );

        byTarget.forEach((_, target) => observer.observe(target));
      }
    </script>
  </body>
</html>
