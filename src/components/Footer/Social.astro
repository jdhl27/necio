---
const socials = [
  {
    href: "https://www.instagram.com/necio.audiovisual/",
    label: "Instagram",
  },
  {
    href: "https://www.youtube.com/@necioaudiovisual",
    label: "YouTube",
  },
  {
    href: "mailto:necioaudiovisual@gmail.com",
    label: "Correo",
  },
];
---

<div class="flex flex-wrap gap-3">
  {
    socials.map((s) => (
      <a
        href={s.href}
        aria-label={s.label}
        rel="noopener"
        target={s.href.startsWith("mailto") ? undefined : "_blank"}
        class="border border-line px-5 py-3 text-xs font-medium uppercase tracking-widecaps text-cream/80 transition-colors hover:border-yellow hover:text-yellow"
      >
        {s.label} &nearr;
      </a>
    ))
  }
</div>
