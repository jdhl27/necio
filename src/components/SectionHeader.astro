---
export interface Props {
  num: string;
  title: string;
  sub?: string;
}
const { num, title, sub } = Astro.props;
---

<div class="mb-10 flex flex-wrap items-end justify-between gap-4">
  <div>
    <p class="slate">{num}</p>
    <h2
      class="display mt-3 text-fluid-title"
      data-test="header-title"
    >
      {title}
    </h2>
    {
      sub && (
        <p
          class="mt-3 max-w-lg text-muted"
          data-test="header-description"
        >
          {sub}
        </p>
      )
    }
  </div>
  <slot />
</div>
