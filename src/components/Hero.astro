---

---

<header
  class="relative flex min-h-[92svh] flex-col overflow-hidden border-b border-line"
>
  <!-- Resplandor de fondo -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/3 h-[34rem] w-[34rem] -translate-x-1/2 -translate-y-1/2 rounded-full bg-yellow opacity-[0.07] blur-3xl"
    aria-hidden="true"
  >
  </div>

  <!-- Sello circular giratorio -->
  <div
    class="absolute right-10 top-16 hidden h-44 w-44 lg:block xl:right-20"
    aria-hidden="true"
  >
    <img
      src="/images/logo_black.png"
      alt=""
      class="absolute inset-0 m-auto h-16 w-auto invert"
    />
    <svg viewBox="0 0 200 200" class="spin-slow h-full w-full">
      <defs>
        <path
          id="circulo-sello"
          d="M100,100 m-82,0 a82,82 0 1,1 164,0 a82,82 0 1,1 -164,0"></path>
      </defs>
      <text
        fill="rgba(244,241,234,0.55)"
        font-size="14.5"
        letter-spacing="4"
        style="text-transform: uppercase; font-family: 'Space Grotesk', sans-serif;"
      >
        <textPath href="#circulo-sello">
          Productora audiovisual &bull; Medellín &bull; Necio &bull;
        </textPath>
      </text>
    </svg>
  </div>

  <div
    class="mx-auto flex w-full max-w-wrap flex-1 flex-col justify-center px-4 pb-10 pt-14 sm:px-6"
  >
    <p class="slate rise">Productora audiovisual</p>

    <h1
      class="display mt-6 text-[clamp(4.2rem,16vw,14.5rem)]"
      data-test="header-title"
    >
      <span class="rise rise-1 outline-fill block">Ideas</span>
      <span class="rise rise-2 block text-yellow lg:ml-[16%]"
        >Necias<span class="text-pink">.</span></span
      >
    </h1>

    <div
      class="mt-12 flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between"
    >
      <div
        class="rise rise-3 max-w-md border-l-2 border-yellow pl-5"
        data-test="header-description"
      >
        <p class="text-cream/85">
          Somos una productora audiovisual de Medellín. Grabamos y editamos
          historias de artistas, barrios, marcas y gente que hace cosas.
        </p>
        <p class="mt-3 text-sm text-muted">
          Nos dicen necios porque cuando una idea nos gusta, no la soltamos.
        </p>
      </div>

      <div class="rise rise-4 flex flex-wrap items-center gap-4">
        <a
          href="#trabajo"
          class="display inline-block bg-yellow px-8 py-4 text-lg text-ink transition-transform duration-200 hover:-translate-y-1 hover:rotate-1"
          data-test="see-all-link"
        >
          Ver videos &darr;
        </a>
        <a
          href="#contacto"
          class="display inline-block border border-cream/40 px-8 py-4 text-lg text-cream transition-colors hover:border-pink hover:text-pink"
        >
          Escríbenos
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior tipo cámara -->
  <div class="border-t border-line">
    <div
      class="mx-auto flex w-full max-w-wrap items-center justify-between gap-4 px-4 py-4 text-[0.65rem] uppercase tracking-widecaps text-muted sm:px-6"
    >
      <a href="#trabajo" class="transition-colors hover:text-yellow">
        Scroll <span class="inline-block animate-bounce">&darr;</span>
      </a>
      <span class="hidden sm:block">Medellín, Colombia</span>
      <span class="flex items-center gap-2">
        <span class="h-2 w-2 animate-pulse rounded-full bg-pink"></span>
        Rec <span id="timecode" class="tabular-nums">00:00:00:00</span>
        &bull; 4K 24fps
      </span>
    </div>
  </div>
</header>

<style>
  /* Contorno que se rellena al pasar el mouse */
  .outline-fill {
    color: transparent;
    -webkit-text-stroke: 2px #f4f1ea;
    transition: color 0.4s ease;
  }
  .outline-fill:hover {
    color: #f4f1ea;
  }

  .spin-slow {
    animation: spin 22s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Entrada escalonada */
  .rise {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .rise-1 {
    animation-delay: 0.08s;
  }
  .rise-2 {
    animation-delay: 0.18s;
  }
  .rise-3 {
    animation-delay: 0.32s;
  }
  .rise-4 {
    animation-delay: 0.42s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rise,
    .spin-slow,
    .animate-bounce,
    .animate-pulse {
      animation: none;
    }
  }
</style>

<script>
  // Timecode corriendo como cámara en grabación (HH:MM:SS:FF a 24fps)
  const el = document.getElementById("timecode");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (el && !reduced) {
    const start = performance.now();
    const pad = (n: number) => String(n).padStart(2, "0");

    function tick(now: number) {
      const elapsed = (now - start) / 1000;
      const h = Math.floor(elapsed / 3600);
      const m = Math.floor((elapsed % 3600) / 60);
      const s = Math.floor(elapsed % 60);
      const f = Math.floor((elapsed % 1) * 24);
      el!.textContent = `${pad(h)}:${pad(m)}:${pad(s)}:${pad(f)}`;
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
</script>
